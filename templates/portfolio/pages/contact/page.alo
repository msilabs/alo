<head>
    <title>যোগাযোগ | {{ data.site.name }}</title>
</head>

<template>
    <div class="contact">
        <p class="eyebrow">যোগাযোগ</p>
        <h1 class="page-title">একসাথে কাজ করি</h1>
        <p class="lead">নতুন কাজ বা প্রশ্ন থাকলে ইমেইল করুন। ইমেইলের ঠিকানা আছে <code>data/profile.json</code>-এ, আর নিচের লিংকগুলো <code>data/social.json</code>-এ।</p>

        <p class="email"><a class="button button-primary" href="mailto:{{ data.profile.email }}">{{ data.profile.email }}</a></p>

        <ul>
            <template for="link in data.social">
                <li><a href="{{ link.href }}">{{ link.label }} →</a></li>
            </template>
        </ul>
    </div>
</template>

<style>
    .contact {
        max-width: var(--reading);
    }

    .email {
        margin-block: 2rem;
    }

    ul {
        display: grid;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
</style>
