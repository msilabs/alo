<!-- ডকসের সব পেইজ: বাঁয়ে নেভিগেশন, ডানে কনটেন্ট; এটি বসে (site)-এর লেআউটের ভেতরে -->
<template>
    <div class="docs">
        <Docs.Sidebar />
        <div class="content">
            <slot />
        </div>
    </div>
</template>

<style>
    .docs {
        display: grid;
        grid-template-columns: 15rem minmax(0, 1fr);
        gap: 3rem;
        width: min(100% - 2.5rem, 86rem);
        margin-inline: auto;
        padding-block: 2.5rem 4rem;
    }

    @media (max-width: 800px) {
        .docs {
            grid-template-columns: minmax(0, 1fr);
            gap: 1.75rem;
            padding-top: 0;
        }
    }
</style>

<!-- ডকসের প্রতিটি পেইজ এই ক্লাস ব্যবহার করে: মাঝে লেখা, ডানে <Docs.Toc /> -->
<style global>
    .doc-page {
        display: grid;
        grid-template-columns: minmax(0, var(--reading)) 13rem;
        justify-content: space-between;
        gap: 3rem;
    }

    /* sticky হেডারের (ছোট পর্দায় সূচির বারেরও) নিচে হেডিং ঢাকা পড়ে না */
    .doc-page :is(h2, h3)[id] {
        scroll-margin-top: 5.5rem;
    }

    @media (max-width: 1100px) {
        .doc-page {
            grid-template-columns: minmax(0, var(--reading));
            justify-content: start;
        }
    }

    @media (max-width: 800px) {
        .doc-page :is(h2, h3)[id] {
            scroll-margin-top: 8rem;
        }
    }
</style>
