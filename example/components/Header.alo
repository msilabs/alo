<template>
    <header class="site-header">
        <a class="logo" href="/">{{ data.site.name }}</a>
        <nav>
            <template for="link in data.menu">
                <a href="{{ link.href }}" aria-current="{{ route.path === link.href ? 'page' : null }}">{{ link.label }}</a>
            </template>
        </nav>
    </header>
</template>
