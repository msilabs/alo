<template>
    <Card class="post-card">
        <h3><a href="/blog/{{ post.slug }}/">{{ post.title }}</a></h3>
        <time>{{ post.date }}</time>
        <template if="post.tags">
            <ul class="tags">
                <template for="tag in post.tags"><li>{{ tag }}</li></template>
            </ul>
        </template>
    </Card>
</template>
