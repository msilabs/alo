<head>
    <title>{{ data.site.name }} — হালকা স্ট্যাটিক সাইট</title>
</head>

<template>
    <!-- এই কমেন্ট আউটপুটে হুবহু যায় -->
    <svg width="48" height="48" viewBox="0 0 48 48" aria-hidden="true">
        <defs>
            <linearGradient id="glow" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#ffd54f" />
                <stop offset="1" stop-color="#ff8f00" />
            </linearGradient>
        </defs>
        <circle cx="24" cy="24" r="20" fill="url(#glow)" />
    </svg>

    <h1>আলো</h1>
    <p>{{ 'HTML, CSS আর JS লেখো; বিল্ড করলে পাবে ' + 'স্ট্যাটিক সাইট।' }}</p>
    <p>এই পেইজের পাথ: <code>{{ route.path }}</code></p>
    <p>হিসাব বিল্ডের সময়ই হয়: ২ + ৩ = {{ 2 + 3 }}</p>
    <p title="{{ 'তুলনা: ' + (5 > 3 ? "বড়" : 'ছোট') }}">এক্সপ্রেশনে &gt; আর কোট নিরাপদ</p>
    <p>আক্ষরিক বন্ধনী লিখতে: \{{ এভাবে }}</p>

    <pre><code>{{ ['const', 'আলো', '=', "'হালকা';"].join(' ') }}</code></pre>

    <h2>যা লাগে</h2>
    <ul>
        <template for="(tool, i) in ['HTML', 'CSS', 'JavaScript']">
            <li>{{ i + 1 }}. {{ tool }}</li>
        </template>
    </ul>

    <template if="[1, 2, 3].length > 5">
        <p>অনেক কিছু শিখতে হবে।</p>
    </template>
    <template else-if="[1, 2, 3].length > 0">
        <p>মাত্র {{ [1, 2, 3].length }}টা জিনিস জানলেই চলে।</p>
    </template>
    <template else>
        <p>কিছুই লাগে না।</p>
    </template>

    <h2>সাম্প্রতিক লেখা</h2>
    <!-- সর্বশেষ ৩টা পোস্ট, নতুনটা আগে -->
    <Blog.PostList posts="{{ data.blog.toReversed().slice(0, 3) }}" />

    <Card title="ফলব্যাক কনটেন্ট" />

    <h2>প্রশ্ন আর উত্তর</h2>
    <Faq question="Alo কি রিঅ্যাক্টিভ?" answer="না। লুপ আর শর্ত চলে বিল্ডের সময়, একবার; ব্রাউজারে চলে শুধু তোমার লেখা সাধারণ JS।" />
    <Faq question="কনফিগ ফাইল লাগে?" answer="না। সব ঠিক হয় ফোল্ডার আর ফাইলের নাম থেকে।" />

    <h2>কাউন্টার</h2>
    <Counter start="{{ 5 }}" />

    <p>আজকের তারিখ: <span id="today"></span></p>

    <details open="{{ true }}">
        <summary>boolean অ্যাট্রিবিউট</summary>
        <button disabled="{{ 2 > 3 }}" aria-pressed="{{ false }}" title="{{ null }}">চাপো</button>
    </details>

    <button type="button" x-data="{ open: false }" @click="open = !open" :aria-expanded="open">
        Alpine.js-এর অ্যাট্রিবিউট অপরিবর্তিত থাকে
    </button>
</template>

<script>
    // পেইজের নিজের স্ক্রিপ্ট: এখানে $el নেই, সাধারণ DOM API চলে।
    document.getElementById('today').textContent = new Date().toLocaleDateString('bn-BD');
</script>
