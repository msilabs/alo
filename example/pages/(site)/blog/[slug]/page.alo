<head>
    <title>{{ item.title }} | {{ data.site.name }}</title>
    <template if="item.description">
        <meta name="description" content="{{ item.description }}">
    </template>
</head>

<template>
    <article class="post">
        <a class="back" href="/blog/">← সব লেখা</a>
        <h1>{{ item.title }}</h1>
        <p class="meta">
            <time datetime="{{ item.date }}">{{ new Date(item.date).toLocaleDateString('bn-BD', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) }}</time>
            <template for="tag in item.tags ?? []">
                <span class="tag">{{ tag }}</span>
            </template>
        </p>
        <div class="body">
            {{{ item.body }}}
        </div>
    </article>
</template>

<style>
    .back {
        color: var(--muted);
        font-size: 0.95rem;
        text-decoration: none;
    }

    h1 {
        margin-block: 1rem 0.75rem;
        font-size: clamp(1.9rem, 5vw, 2.6rem);
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 2.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.92rem;
    }

    .tag {
        padding: 0 0.55rem;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-size: 0.82rem;
    }
</style>

<!-- Markdown-এর বডি {{{ }}} দিয়ে বসে, তাই তাতে স্কোপ অ্যাট্রিবিউট থাকে না; স্টাইল দিতে <style global> -->
<style global>
    .post .body > * + * {
        margin-top: 1.1rem;
    }

    .post .body h2 {
        margin-top: 2.5rem;
        font-size: 1.5rem;
    }

    .post .body ul,
    .post .body ol {
        padding-left: 1.4rem;
    }

    /* ছোট পর্দায় চওড়া টেবিল নিজে স্ক্রল করে, পুরো পেইজ নয় */
    .post .body table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
        border-collapse: collapse;
        font-size: 0.95rem;
    }

    .post .body th,
    .post .body td {
        padding: 0.55rem 0.75rem;
        border-bottom: 1px solid var(--border);
        text-align: left;
    }

    .post .body blockquote {
        padding: 0.25rem 0 0.25rem 1.25rem;
        border-left: 3px solid var(--accent);
        color: var(--muted);
    }
</style>
