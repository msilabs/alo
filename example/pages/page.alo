<head>
    <title>আলো — হালকা স্ট্যাটিক সাইট</title>
    <meta name="description" content="Alo দিয়ে বানানো উদাহরণ সাইট">
</head>

<template>
    <!-- এই কমেন্ট আউটপুটে হুবহু যায় -->
    <main>
        <svg width="48" height="48" viewBox="0 0 48 48" aria-hidden="true">
            <defs>
                <linearGradient id="glow" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#ffd54f" />
                    <stop offset="1" stop-color="#ff8f00" />
                </linearGradient>
            </defs>
            <circle cx="24" cy="24" r="20" fill="url(#glow)" />
        </svg>

        <h1>আলো</h1>
        <p>{{ 'HTML, CSS আর JS লেখো; বিল্ড করলে পাবে ' + 'স্ট্যাটিক সাইট।' }}</p>
        <p>এই পেইজের পাথ: <code>{{ route.path }}</code></p>
        <p>হিসাব বিল্ডের সময়ই হয়: ২ + ৩ = {{ 2 + 3 }}</p>
        <p title="{{ 'তুলনা: ' + (5 > 3 ? "বড়" : 'ছোট') }}">এক্সপ্রেশনে &gt; আর কোট নিরাপদ</p>
        <p>আক্ষরিক বন্ধনী লিখতে: \{{ এভাবে }}</p>

        <pre><code>{{ ['const', 'আলো', '=', "'হালকা';"].join(' ') }}</code></pre>

        <button type="button" x-data="{ open: false }" @click="open = !open" :aria-expanded="open">
            Alpine.js-এর অ্যাট্রিবিউট অপরিবর্তিত থাকে
        </button>
    </main>
</template>
